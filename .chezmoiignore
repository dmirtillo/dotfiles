# =============================================================================
# Files to ignore per platform
# chezmoi will not manage these files on the excluded platforms
# =============================================================================

# Repo metadata, docs and tooling (never deploy to home)
AGENTS.md
README.md
Brewfile
Pacfile
Winfile
docs/
dot_local/bin
dot_termux
run_once_*
run_onchange_*
.pre-commit-config.yaml
.chezmoiexternal.toml
.chezmoiremove

{{ if ne .chezmoi.os "darwin" }}
# macOS-only files
Brewfile
private_Library
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# Linux-only files
Pacfile
.makepkg.conf
.config/systemd
{{ end }}

{{ if ne .chezmoi.os "windows" }}
# Windows-only files
Winfile
Documents/PowerShell
{{ end }}

# Ignore node_modules globally so they don't get tracked or synced back
**/node_modules
**/node_modules/**

# Ignore binary office files to prevent template corruption
*.docx
*.pptx

# OpenCode config, plugins and skill content managed directly / from source
.config/opencode/opencode.json
.config/opencode/plugins/**
.opencode
.planning

# Dynamically ignore work Git configuration if not set
{{ if not (get . "work_email") }}
.gitconfig-work
{{ end }}
