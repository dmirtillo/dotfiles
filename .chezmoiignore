# =============================================================================
# Files to ignore per platform
# chezmoi will not manage these files on the excluded platforms
# =============================================================================

# Repo metadata and docs (never deploy to home)
AGENTS.md
README.md
LICENSE
Brewfile
Pacfile
.ecc-version
.gitmodules

# Old files (kept for reference during migration, remove later)
scripts/
config.sh.example
config.sh
opencode/
git/
zsh/
vim/
ssh/
vendor/
iterm2/

{{ if ne .chezmoi.os "darwin" }}
# macOS-only files
Brewfile
private_Library
{{ end }}

{{ if ne .chezmoi.os "linux" }}
# Linux-only files
Pacfile
.config/systemd
{{ end }}

{{ if ne .chezmoi.os "windows" }}
# Windows-only files
Wingetfile.json
Documents/PowerShell
{{ end }}

# Ignore node_modules globally so they don't get tracked or synced back
**/node_modules
**/node_modules/**

# Ignore binary office files to prevent template corruption
*.docx
*.pptx

# Dynamically ignore work Git configuration if not set
{{ if not .work_email }}
.gitconfig-work
{{ end }}
