#!/usr/bin/env bash
# =============================================================================
# Trust mise configuration
# chezmoi:template:hash {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}
# =============================================================================

set -euo pipefail

if command -v mise &> /dev/null; then
    rm -f ~/.mise.toml
    echo "[mise] Trusting ~/.config/mise/config.toml..."
    mise trust ~/.config/mise/config.toml || true
    echo "[mise] Installing tools from ~/.config/mise/config.toml..."
    mise install || true
    mise upgrade || true
fi
