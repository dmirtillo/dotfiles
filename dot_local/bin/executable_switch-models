#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# switch-models — Hot-swap OpenCode's active LLM provider
#
# Usage:
#   switch-models gemini     Set pro agents to Gemini 4 Argon
#   switch-models anthropic  Set pro agents to Claude Sonnet 5.5 (via LiteLLM)
#   switch-models xai        Set pro agents to Grok 4.7 (via LiteLLM)
#   switch-models status     Show current model configuration (default)
#
# WHAT IT DOES:
#   Edits ~/.config/opencode/opencode.json in-place using jq, updating:
#     .model           — the default/main model
#     .small_model     — the fast/cheap model
#     .agent[*].model  — per-agent model overrides (pro → pro, flash → flash)
#
# NOTE — opencode.json is GENERATED, not a template:
#   run_onchange_setup-opencode.sh.tmpl writes it on every `chezmoi apply` and
#   overwrites anything this script changes. Use this for session-level swaps
#   only; for a permanent change edit the generator in that script.
#
# ROUTING CONTEXT:
#   gemini     → google/ provider (@ai-sdk/google, direct Google AI Studio)
#   anthropic  → litellm/ provider (@ai-sdk/openai-compatible, localhost:4000)
#                LiteLLM proxies to Vertex AI using gcloud ADC.
#   xai        → litellm/xai/ provider (Grok 4.7 via the Vertex partner endpoint)</｜DSML｜ parameter>,
#
# DEPENDENCIES:
#   jq  (brew install jq)
#
# FLASH MODEL:
#   The small_model always stays as Gemini Flash in every mode — there is no
#   cheap fast model available via Vertex AI at the time of writing.
# =============================================================================

CONFIG="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"

GEMINI_PRO="google/gemini-4-argon"
GEMINI_FLASH="google/gemini-3.8-flash"
ANTHROPIC_PRO="litellm/claude-sonnet-5-5"
# litellm proxies Vertex's partner endpoints; opencode nests the provider (xai)
# inside the litellm provider name, so the model key in opencode.json is
# "xai/grok-4.7" and the fully-qualified id is litellm/xai/grok-4.7.
XAI_PRO="litellm/xai/grok-4.7"

readonly CONFIG GEMINI_PRO GEMINI_FLASH ANTHROPIC_PRO XAI_PRO
usage() {
  echo "Usage: switch-models [gemini|anthropic|xai|status]"
  echo ""
  echo "  gemini     Use Gemini models (pro + flash)"
  echo "  anthropic  Use Claude Sonnet 5.5 via LiteLLM (keep flash)"
  echo "  xai        Use Grok 4.7 via LiteLLM (keep flash)"
  echo "  status     Show current model configuration (default)"
  exit 1
}

check_deps() {
  if ! command -v jq &>/dev/null; then
    echo "ERROR: jq is required but not found. Install with: brew install jq"
    exit 1
  fi
  if [ ! -f "$CONFIG" ]; then
    echo "ERROR: OpenCode config not found at $CONFIG"
    exit 1
  fi
}

# Verify the fully-qualified model id exists in the generated config's provider
# map. Guards against provider/model renames in run_onchange_setup-opencode.sh.tmpl
# drifting away from the constants above (litellm/xai/grok-4.7, not litellm/grok-4.7).
check_model_exists() {
  local id="$1" provider model
  provider="${id%%/*}"
  model="${id#*/}"
  if ! sed 's|^[[:space:]]*//.*||g' "$CONFIG" |
       jq -e --arg p "$provider" --arg m "$model" \
         '.provider[$p].models[$m] != null' >/dev/null 2>&1; then
    echo "ERROR: model '$id' is not defined in $CONFIG" >&2
    echo "       (provider '$provider', model '$model') — check switch-models constants" >&2
    exit 1
  fi
}

status() {
  local main_model small_model clean_json
  clean_json=$(sed 's|^[[:space:]]*//.*||g' "$CONFIG")
  main_model=$(echo "$clean_json" | jq -r '.model')
  small_model=$(echo "$clean_json" | jq -r '.small_model')

  # Determine current mode
  local mode="unknown"
  case "$main_model" in
    *claude*)   mode="anthropic" ;;
    *grok*)     mode="xai" ;;
    *deepseek*) mode="deepseek" ;;
    *gemini*)   mode="gemini" ;;
  esac

  echo "Mode: $mode"
  echo ""
  echo "  model:       $main_model"
  echo "  small_model: $small_model"
  echo ""
  echo "  Agents:"
  echo "$clean_json" | jq -r '
    (.agent // {}) | to_entries[] |
    "    \(.key): \(.value.model // "(inherits main model)")"
  '
}

switch_models() {
  local pro="$1"
  local flash="$2"
  local label="$3"
  local tmp="${CONFIG}.tmp.$$"
  local clean_json
  clean_json=$(sed 's|^[[:space:]]*//.*||g' "$CONFIG")

  echo "$clean_json" | jq \
    --arg pro "$pro" \
    --arg flash "$flash" \
    '
    .model = $pro |
    .small_model = $flash |
    .agent |= (if . then with_entries(
      if .value.model then
        if (.value.model | test("flash|haiku")) then
          .value.model = $flash
        else
          .value.model = $pro
        end
      else
        .
      end
    ) else null end)
    ' > "$tmp" && mv "$tmp" "$CONFIG"

  echo "Switched to $label mode."
  echo ""
  status

  # Notify user if OpenCode is running
  if pgrep -f "opencode" >/dev/null 2>&1; then
    echo ""
    echo "OpenCode is running. Restart it for changes to take effect."
  fi
}

check_deps

case "${1:-status}" in
  gemini)    check_model_exists "$GEMINI_PRO"; switch_models "$GEMINI_PRO" "$GEMINI_FLASH" "Gemini" ;;
  anthropic) check_model_exists "$ANTHROPIC_PRO"; switch_models "$ANTHROPIC_PRO" "$GEMINI_FLASH" "Anthropic" ;;
  xai)       check_model_exists "$XAI_PRO"; switch_models "$XAI_PRO" "$GEMINI_FLASH" "xAI" ;;
  status)    status ;;
  -h|--help) usage ;;
  *)         usage ;;
esac
