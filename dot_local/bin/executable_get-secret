#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# get-secret — read a secret from the platform's native store
#
# Backends, in order:
#   1. $SECRET_FILE_DIR/<name>   — plain 0600 file (any platform, explicit override)
#   2. macOS                     — Keychain (security find-generic-password)
#   3. Linux + DBus session      — Secret Service (secret-tool: KWallet/ksecretd
#                                  on KDE, gnome-keyring elsewhere)
#   4. Linux, headless           — `pass show <prefix>/<name>`
#
# Usage:
#   get-secret gemini-api-key            # print the secret
#   get-secret --set gemini-api-key      # store a secret interactively
#
# Naming:
#   macOS Keychain service:  <name>          (e.g. gemini-api-key)
#   Secret Service:          service=<name>
#   pass:                    <GPG_PREFIX>/<name>, default "dotfiles/<name>"
# =============================================================================

_EXPLICIT_SECRET_FILE_DIR="${SECRET_FILE_DIR:-}"
SECRET_FILE_DIR="${SECRET_FILE_DIR:-$HOME/.config/secrets}"
GPG_PREFIX="${GPG_PREFIX:-dotfiles}"

usage() {
  echo "Usage: get-secret [--set] <name>" >&2
  exit 2
}

store_file() {
  local name="$1" value
  read -r -s -p "Value for $name: " value
  echo >&2
  mkdir -p "$SECRET_FILE_DIR"
  chmod 700 "$SECRET_FILE_DIR"
  printf '%s' "$value" > "$SECRET_FILE_DIR/$name"
  chmod 600 "$SECRET_FILE_DIR/$name"
  echo "Stored in $SECRET_FILE_DIR/$name (mode 600)." >&2
}

backend() {
  if [[ -n "$_EXPLICIT_SECRET_FILE_DIR" ]]; then
    echo file
  elif [[ "$(uname -s)" == "Darwin" ]]; then
    echo macos
  elif [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v secret-tool &>/dev/null; then
    echo secretservice
  elif command -v pass &>/dev/null && [[ -f "${PASSWORD_STORE_DIR:-$HOME/.password-store}/.gpg-id" ]]; then
    echo pass
  else
    echo file
  fi
}

fetch() {
  local name="$1"

  if [[ -n "${SECRET_FILE_DIR:-}" && -f "$SECRET_FILE_DIR/$name" ]]; then
    cat "$SECRET_FILE_DIR/$name"; return 0
  fi

  case "$(backend)" in
    macos)
      security find-generic-password -s "$name" -w 2>/dev/null && return 0
      ;;
    secretservice)
      secret-tool lookup service "$name" 2>/dev/null && return 0
      ;;
    pass)
      pass show "$GPG_PREFIX/$name" 2>/dev/null && return 0
      ;;
  esac

  if [[ -f "$SECRET_FILE_DIR/$name" ]]; then
    cat "$SECRET_FILE_DIR/$name"; return 0
  fi

  echo "get-secret: '$name' not found (backend: $(backend)). Store it with: get-secret --set $name" >&2
  return 1
}

case "${1:-}" in
  --set)
    [[ $# -eq 2 ]] || usage
    case "$(backend)" in
      macos)
        read -r -s -p "Value for $2: " v; echo >&2
        security add-generic-password -a "$USER" -s "$2" -w "$v" -U
        ;;
      secretservice)
        read -r -s -p "Value for $2: " v; echo >&2
        printf '%s' "$v" | secret-tool store --label="$2" service "$2"
        ;;
      pass)
        read -r -s -p "Value for $2: " v; echo >&2
        printf '%s\n' "$v" | pass insert -m -f "$GPG_PREFIX/$2"
        ;;
      *)
        store_file "$2"
        ;;
    esac
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    fetch "$1"
    ;;
esac
