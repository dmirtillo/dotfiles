# =============================================================================
# LiteLLM Proxy Configuration
# Deployed to ~/.config/litellm/config.yaml by chezmoi
#
# PURPOSE:
#   Acts as a local OpenAI-compatible proxy exclusively for Anthropic Claude
#   models via Vertex AI. Runs on http://localhost:4000.
#
# ROUTING:
#   - claude-*  →  Vertex AI (gcloud ADC, no API key needed)
#   - gemini-*  →  Vertex AI (gcloud ADC)
#
# NO DATABASE:
#   Runs completely DB-free (no PostgreSQL). master_key is null so the proxy
#   accepts all requests without authentication. This is safe ONLY because it is
#   bound to 127.0.0.1 via --host (see the LaunchAgent / systemd unit) — never
#   run it without that flag.
#   The /ui endpoint is available but shows login errors without a DB; use
#   `tail -f ~/.local/share/litellm/proxy.log` to monitor live traffic instead.
#
# OPENCODE:
#   OpenCode sends Claude and Grok through this proxy (OpenAI-compatible API)
#
# LOGS:
#   stdout → ~/.local/share/litellm/proxy.log
#   stderr → ~/.local/share/litellm/proxy.err
# =============================================================================

model_list:
  # --- Gemini models (via Vertex AI, global endpoint) ---
  - model_name: gemini-4-argon
    litellm_params:
      model: vertex_ai/gemini-4-argon
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "{{ (get . "gcloud_location") | default "global" }}"

  - model_name: gemini-4-carbon
    litellm_params:
      model: vertex_ai/gemini-4-carbon
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "{{ (get . "gcloud_location") | default "global" }}"
    model_info:
      input_cost_per_token: 0.000004
      output_cost_per_token: 0.000020
      cache_read_input_token_cost: 0.0000002

  - model_name: gemini-4-hydrogen
    litellm_params:
      model: vertex_ai/gemini-4-hydrogen
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "{{ (get . "gcloud_location") | default "global" }}"
    model_info:
      input_cost_per_token: 0.0000015
      output_cost_per_token: 0.0000075
      cache_read_input_token_cost: 0.000000075

  - model_name: gemini-3.8-flash
    litellm_params:
      model: vertex_ai/gemini-3.8-flash
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "{{ (get . "gcloud_location") | default "global" }}"

  #    Vertex rejects a request carrying both temperature and top_p, and the
  #    AI-SDK sends both by default. Claude 5.5 additionally accepts only
  #    temperature=1 (LiteLLM enforces this before the call reaches Vertex), so
  #    both parameters are stripped at the edge rather than patching LiteLLM.
  # --- Anthropic models (via Vertex AI, global endpoint) ---
  - model_name: claude-haiku-5-5
    litellm_params:
      model: vertex_ai/claude-haiku-5-5
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"
      additional_drop_params: ["top_p", "temperature"]

  - model_name: claude-sonnet-5-5
    litellm_params:
      model: vertex_ai/claude-sonnet-5-5
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"
      additional_drop_params: ["top_p", "temperature"]

  - model_name: claude-opus-5-5
    litellm_params:
      model: vertex_ai/claude-opus-5-5@default
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"
      additional_drop_params: ["top_p", "temperature"]

  # --- xAI Grok models (via Vertex AI, global endpoint) ---
  - model_name: xai/grok-4.7
    litellm_params:
      model: vertex_ai/xai/grok-4.7
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"

  - model_name: grok-4.7
    litellm_params:
      model: vertex_ai/xai/grok-4.7
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"

  # --- DeepSeek models (via Vertex AI, global endpoint) ---
  - model_name: deepseek-ai/deepseek-v4.1-flash-maas
    litellm_params:
      model: vertex_ai/deepseek-ai/deepseek-v4.1-flash-maas
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"

  - model_name: deepseek-4.1-flash
    litellm_params:
      model: vertex_ai/deepseek-ai/deepseek-v4.1-flash-maas
      vertex_project: "{{ get . "gcloud_project" }}"
      vertex_location: "global"

general_settings:
  master_key: null
  dangerously_permit_weak_or_unset_master_key: true

litellm_settings:
  modify_params: true
