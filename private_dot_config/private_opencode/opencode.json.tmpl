{
  // ============================================================================
  // OpenCode Configuration
  // Deployed to ~/.config/opencode/opencode.json by chezmoi (as .tmpl)
  //
  // MODEL ROUTING:
  //   Gemini models  →  google/ provider (@ai-sdk/google, direct Google AI Studio)
  //   Claude models  →  litellm/ provider (@ai-sdk/openai-compatible, localhost:4000)
  // ============================================================================
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "model": "google/gemini-3.8-flash",
  "small_model": "google/gemini-3.8-flash",
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google AI Studio",
      "options": {
        "apiKey": "{{ get . "gemini_api_key" }}"
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        }
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (Vertex Proxy)",
      "options": {
        "baseURL": "http://localhost:4000/v1"
      },
      "models": {
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5 (Vertex)"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5 (Vertex)"
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (Vertex)"
        },
        "xai/grok-4.6": {
          "name": "Grok 4.6 (Vertex)"
        }
      }
    }
  },
  "permission": {
    "mcp_*": "ask"
  },
  "mcp": {
    "gcp-cost": {
      "type": "local",
      "command": ["{{ .chezmoi.homeDir }}/.local/share/mise/shims/gcp-cost-mcp-server"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "{{ get . "gcloud_project" }}"
      }
    }{{- if hasKey . "aws_profile" }},
    "aws-pricing": {
      "type": "local",
      "command": [
        "/usr/bin/env",
        "AWS_PROFILE={{ get . "aws_profile" }}",
        "AWS_REGION=us-east-1",
        "HOME={{ .chezmoi.homeDir }}",
        "AWS_SHARED_CREDENTIALS_FILE={{ .chezmoi.homeDir }}/.aws/credentials",
        "uvx",
        "awslabs.aws-pricing-mcp-server"
      ],
      "env": {
        "AWS_PROFILE": "{{ get . "aws_profile" }}",
        "AWS_REGION": "us-east-1",
        "HOME": "{{ .chezmoi.homeDir }}",
        "AWS_SHARED_CREDENTIALS_FILE": "{{ .chezmoi.homeDir }}/.aws/credentials"
      }
    }
    {{- end }}
  }
}
