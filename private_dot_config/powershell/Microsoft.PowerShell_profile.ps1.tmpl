function localip { ipconfig getifaddr en0 }
function ports { lsof -i -P @args }
function listening { lsof -i -P | Select-String "LISTEN" }
function kport {
    param([Parameter(Mandatory=$true)][string]$Port)
    $pids = lsof -ti ":$Port"
    if ($pids) {
        Write-Host "Killing processes on port ${Port}: $pids"
        $pids | ForEach-Object { kill -9 $_ }
    } else {
        Write-Host "No process found running on port $Port"
    }
}
{{- else if eq .chezmoi.os "linux" }}
function localip { (hostname -I).Split()[0] }
function ports { ss -tulpn @args }
function listening { ss -tulpn | Select-String "LISTEN" }
function kport {
    param([Parameter(Mandatory=$true)][string]$Port)
    fuser -k $Port/tcp
}
{{- else }}
function localip { (Test-Connection -ComputerName $env:COMPUTERNAME -Count 1).IPv4Address.IPAddressToString }
function ports { netstat -ano @args }
function listening { netstat -ano | Select-String "LISTENING" }
function kport {
    param([Parameter(Mandatory=$true)][string]$Port)
    $Matches = (netstat -ano | Select-String ":$Port\s+.*\s+(\d+)")
    if ($Matches) {
        $Pids = $Matches | ForEach-Object { $_.Matches.Groups[1].Value } | Select-Object -Unique
        Write-Host "Killing processes on port ${Port}: $Pids"
        foreach ($p in $Pids) { Stop-Process -Id $p -Force -ErrorAction SilentlyContinue }
    } else {
        Write-Host "No process found running on port $Port"
    }
}
{{- end }}
