#!/bin/bash
# hash: {{ get . "gcloud_project" }}

set -euo pipefail

DEST="$HOME/Documents/template.docx"
mkdir -p "$(dirname "$DEST")"
cp "{{ .chezmoi.sourceDir }}/base_template.docx" "$DEST"

officecli set "$DEST" / --find "PLACEHOLDER_STRING" --replace "{{ get . "gcloud_project" }}"
officecli close "$DEST"
