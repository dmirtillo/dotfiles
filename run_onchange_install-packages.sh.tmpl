#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# Install packages (runs when Brewfile or Pacfile changes)
# chezmoi:template:hash {{ if eq .chezmoi.os "darwin" }}{{ include "Brewfile" | sha256sum }}{{ else if eq .chezmoi.os "linux" }}{{ include "Pacfile" | sha256sum }}{{ end }}
# =============================================================================

{{ if eq .chezmoi.os "darwin" -}}
echo "[packages] Installing Homebrew packages..."
if command -v brew &>/dev/null; then
  set +e
  brew bundle install --file="{{ .chezmoi.sourceDir }}/Brewfile" 2>&1 | sed 's/^/  /'
  brew_status=${PIPESTATUS[0]}
  set -e
  if [ "$brew_status" -ne 0 ]; then
    echo "  WARNING: brew bundle exited $brew_status — some packages may be missing (see output above)" >&2
  fi
else
  echo "  WARNING: Homebrew not installed. Install from https://brew.sh/"
fi
# Install or upgrade the LiteLLM proxy via pipx (always the latest release;
# this repo deliberately pins nothing, including Python).
# WHY pipx: isolates litellm and its heavy dependency tree from the system Python.
# WHY no --python pin: an earlier revision pinned python3.13 because litellm's
#   grpcio dependency had no prebuilt wheel for newer Pythons on macOS arm64 and
#   fell back to a source build that fails without Xcode headers. grpcio now
#   ships prebuilt wheels for 3.13-3.15 and litellm supports >=3.10,<3.16, so
#   pipx picks the default interpreter and always tracks the latest release.
# WHY google-cloud-aiplatform inject: litellm's [proxy] extra does not pull in the
#   Vertex AI SDK automatically; it is required for Claude models via Vertex.
# AFTER EVERY INSTALL/UPGRADE: run litellm-patch, because recreating the venv
#   wipes the local xAI patch.
if command -v pipx &>/dev/null; then
  VENV_PY="$HOME/.local/pipx/venvs/litellm/bin/python"
  if ! pipx list --short 2>/dev/null | grep -q '^litellm '; then
    echo "[packages] Installing litellm proxy (latest)..."
    pipx install 'litellm[proxy]' 2>&1 | sed 's/^/  /'
  else
    echo "[packages] Upgrading litellm proxy to latest..."
    pipx upgrade litellm 2>&1 | sed 's/^/  /' || \
      echo "  WARNING: pipx upgrade litellm failed (see above)" >&2
  fi

  # The Vertex SDK is a separate inject; a recreated venv can drop it.
  if ! "$VENV_PY" -c 'import google.cloud.aiplatform' 2>/dev/null; then
    echo "[packages] Injecting google-cloud-aiplatform (Vertex SDK)..."
    pipx inject litellm 'google-cloud-aiplatform>=1.38' 2>&1 | sed 's/^/  /'
  fi

  "$HOME/.local/bin/litellm-patch" 2>&1 | sed 's/^/  /' || \
    echo "  WARNING: litellm-patch failed (see above)" >&2
else
  echo "  WARNING: pipx not found. Install litellm manually: pipx install 'litellm[proxy]'"
fi

# Ensure the log directory exists before launchd starts the service.
# Logs: stdout → proxy.log, stderr → proxy.err (configured in the plist).
mkdir -p "$HOME/.local/share/litellm"

# (Re)load the LiteLLM launchd service so config changes take effect immediately.
# The plist is deployed by chezmoi to ~/Library/LaunchAgents/ and starts the proxy
# at login. We unload first (|| true so it does not fail on first-ever install)
# then reload to pick up any updated config.yaml or plist changes.
if [ -f "$HOME/Library/LaunchAgents/com.litellm.proxy.plist" ]; then
  launchctl unload "$HOME/Library/LaunchAgents/com.litellm.proxy.plist" 2>/dev/null || true
  launchctl load "$HOME/Library/LaunchAgents/com.litellm.proxy.plist" 2>&1 | sed 's/^/  /'
  echo "[packages] LiteLLM proxy service loaded."
fi
{{ else if eq .chezmoi.os "linux" -}}
echo "[packages] Installing Arch Linux packages from Pacfile..."

PACFILE="{{ .chezmoi.sourceDir }}/Pacfile"

if [ ! -f "$PACFILE" ]; then
  echo "  ERROR: Pacfile not found at $PACFILE"
  exit 1
fi

# Detect whether the host has a GUI stack (display server, DE/WM, or active display).
HAS_GUI=0
if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ] || [ -e /etc/systemd/system/display-manager.service ] \
  || pacman -Qq 2>/dev/null | grep -qE '^(xorg-server|xorg-xwayland|plasma-desktop|plasma-meta|gnome-shell|xfce4-session|sway|hyprland|i3-wm|river|niri|wayfire|sddm|gdm|lightdm|ly|greetd)$'; then
  HAS_GUI=1
fi

# Parse Pacfile: strip comments/blank lines, and skip @gui packages when headless
if [ "$HAS_GUI" -eq 1 ]; then
  PACKAGES=$(sed 's/[[:space:]]*#.*//' "$PACFILE" | grep -v '^$' | tr '\n' ' ')
else
  echo "  Headless/no-GUI system detected — skipping @gui packages."
  PACKAGES=$(grep -v '#[[:space:]]*@gui' "$PACFILE" | sed 's/[[:space:]]*#.*//' | grep -v '^$' | tr '\n' ' ')
fi

if [ -z "$PACKAGES" ]; then
  echo "  No packages to install."
  exit 0
fi

# Refresh package database first (avoids stale mirror 404 errors)
echo "  Refreshing package database..."
sudo pacman -Sy 2>&1 | sed 's/^/  /'

# Ensure required locales are generated to prevent perl warnings
echo "  Ensuring locales are generated..."
if grep -q '^#en_GB.UTF-8 UTF-8' /etc/locale.gen 2>/dev/null; then
  sudo sed -i 's/^#en_GB.UTF-8 UTF-8/en_GB.UTF-8 UTF-8/' /etc/locale.gen
  LOCALE_CHANGED=1
fi
if grep -q '^#it_IT.UTF-8 UTF-8' /etc/locale.gen 2>/dev/null; then
  sudo sed -i 's/^#it_IT.UTF-8 UTF-8/it_IT.UTF-8 UTF-8/' /etc/locale.gen
  LOCALE_CHANGED=1
fi
if [ "${LOCALE_CHANGED:-0}" -eq 1 ]; then
  sudo locale-gen 2>&1 | sed 's/^/  /'
fi

if command -v yay &>/dev/null; then
  # yay handles both official repos and AUR
  # --needed skips already-installed packages
  # --noconfirm avoids interactive prompts
  #
  # Non-fatal: yay aborts the whole transaction when ONE AUR package fails to
  # build (observed with python-msal-extensions, whose upstream test suite
  # fails headless). Without this guard that single failure kills provisioning
  # before the rest of the Pacfile is installed.
  echo "  Using yay (official + AUR)..."
  set +e
  yay -S --needed --noconfirm $PACKAGES 2>&1 | sed 's/^/  /'
  yay_status=${PIPESTATUS[0]}
  set -e
  if [ "$yay_status" -ne 0 ]; then
    echo "  WARNING: yay exited $yay_status — some packages may be missing (see output above)" >&2
  fi
elif command -v pacman &>/dev/null; then
  # Fallback to pacman (official repos only -- AUR packages will fail)
  echo "  WARNING: yay not found, using pacman (AUR packages will be skipped)."
  echo "  Install yay first: https://github.com/Jguer/yay"
  sudo pacman -S --needed --noconfirm $PACKAGES 2>&1 | sed 's/^/  /' || true
else
  echo "  ERROR: Neither yay nor pacman found. Is this Arch Linux?"
  exit 1
fi

# Fallback: ensure markitdown[all] is installed if not provided by package manager
if ! command -v markitdown &>/dev/null && command -v uv &>/dev/null; then
  echo "  [packages] Installing markitdown[all] via uv tool fallback..."
  uv tool install "markitdown[all]" 2>&1 | sed 's/^/  /' || true
fi

# Ensure the log directory exists before systemd starts the service.
mkdir -p "$HOME/.local/share/litellm"

# (Re)load and enable the litellm systemd user service so changes take effect immediately.
if [ -f "$HOME/.config/systemd/user/litellm.service" ] && command -v systemctl &>/dev/null; then
  # A non-login shell (SSH, this script) has neither of these set, and
  # `systemctl --user` needs both to reach the per-user manager:
  #   "Failed to connect to user scope bus ... $DBUS_SESSION_BUS_ADDRESS and
  #    $XDG_RUNTIME_DIR not defined"
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR}/bus}"

  # Keep the user manager alive when there is no login session (headless/SSH),
  # otherwise the proxy dies at logout. Only needs doing once; harmless to repeat.
  if command -v loginctl &>/dev/null; then
    loginctl enable-linger "$USER" 2>/dev/null || true
  fi

  echo "  [packages] Reloading litellm systemd user service..."
  if systemctl --user daemon-reload 2>/dev/null; then
    systemctl --user enable --now litellm 2>&1 | sed 's/^/  /' || true
    echo "  [packages] LiteLLM proxy service active."
  else
    echo "  [packages] Note: Systemd user bus not accessible; skipping litellm service reload." >&2
  fi
fi

echo "  Done."
{{ end -}}
